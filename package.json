{
  "name": "citebloom",
  "type": "module",
  "version": "3.9.5",
  "description": "Personalized Research Discovery Agent for Zotero",
  "config": {
    "addonName": "CiteBloom",
    "addonID": "zotero-llm@github.com.yilewang",
    "addonRef": "llmforzotero",
    "addonInstance": "LLMForZotero",
    "prefsPrefix": "extensions.zotero.llmforzotero"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ck-alpha/CiteBloom.git"
  },
  "author": "Yile Wang",
  "bugs": {
    "url": "https://github.com/ck-alpha/CiteBloom/issues"
  },
  "homepage": "https://github.com/ck-alpha/CiteBloom#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && npm run typecheck",
    "check:cycles": "node scripts/check-import-cycles.cjs",
    "validate:model-registry": "node scripts/validate-model-capability-registry.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:workflow",
    "test:unit": "npx tsx node_modules/mocha/bin/mocha.js --require ./test/register.cjs 'test/**/*.test.ts'",
    "test:workflow": "node scripts/run-workflow-tests.mjs",
    "test:webchat:live": "node scripts/run-workflow-tests.mjs --webchat-live",
    "update-deps": "npm update --save",
    "test:agent:live": "node scripts/run-workflow-tests.mjs --agent-live",
    "eval:citebloom:prepare": "node --use-env-proxy --use-system-ca --import tsx scripts/evaluation/cli.ts prepare",
    "eval:citebloom:run": "tsx scripts/evaluation/cli.ts run",
    "eval:citebloom:report": "tsx scripts/evaluation/cli.ts report",
    "eval:citebloom:typecheck": "tsc --noEmit -p scripts/evaluation/tsconfig.json",
    "eval:citebloom:openalex": "node --use-env-proxy --use-system-ca scripts/openalex-smoke.mjs",
    "test:offline": "npm run typecheck && npm run test:unit && npm run check:cycles",
    "test:feedback:sqlite": "npx tsx node_modules/mocha/bin/mocha.js --require ./test/register.cjs test/recommendationFeedbackSqliteLifecycle.test.ts",
    "test:eval:citebloom": "tsx node_modules/mocha/bin/mocha.js --require ./test/register.cjs test/citebloomOfflineEvaluation.test.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.28",
    "marked": "^16.4.2",
    "mermaid": "^11.15.0",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^10.9.1",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
